# PhishShield Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ─── Security ────────────────────────────────────────────────────────────────
# 32-byte URL-safe base64-encoded random key for AES-256-GCM master key
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AES_MASTER_KEY=CHANGE_ME_32_BYTE_BASE64_URLSAFE_KEY==

# JWT signing secret (any long random string)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_STRING

# JWT algorithm
JWT_ALGORITHM=HS256

# Token expiry in minutes
JWT_EXPIRE_MINUTES=60

# ─── Admin Credentials (seeded on first run) ─────────────────────────────────
ADMIN_EMAIL=admin@phishshield.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./phishshield.db

# ─── TLS / HTTPS ──────────────────────────────────────────────────────────────
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key
TLS_CA_FILE=certs/ca.crt

# ─── SMTP Ingest ──────────────────────────────────────────────────────────────
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
SMTP_REQUIRE_STARTTLS=true

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8443
CORS_ORIGINS=https://localhost:5173,https://localhost:3000

# ─── Risk Score Thresholds ────────────────────────────────────────────────────
THRESHOLD_SUSPICIOUS=41
THRESHOLD_MALICIOUS=71

# ─── DNS / Auth Mode ──────────────────────────────────────────────────────────
# Set to "test" to use local fake-DNS resolver (no real DNS lookups)
AUTH_DNS_MODE=live

# ─── VirusTotal (optional) ────────────────────────────────────────────────────
# Leave blank to disable attachment hash lookup
VT_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Replay Protection ────────────────────────────────────────────────────────
# Max age of a signed message timestamp in seconds (±)
REPLAY_TIMESTAMP_WINDOW_SECONDS=300

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://localhost:8443
